---
import Base from '../layouts/Base.astro';
import { ArrowDown, ArrowUpRight, AudioLines, Boxes, Camera, Check, CreditCard, MapPin, MessageCircle, PackageSearch, Plug, Printer, RefreshCw, ScanFace, ShieldCheck, ShoppingCart, Sparkles, Store, Users, X } from 'lucide-astro';
const features=[
 [AudioLines,'Atendimento por voz','Conversa natural para orientar clientes e agilizar tarefas.'],
 [PackageSearch,'Consulta instantânea','Preço, disponibilidade e localização do produto na loja.'],
 [CreditCard,'Pagamento via PIX','QR Code para receber pagamentos direto no terminal.'],
 [Printer,'Comprovantes','Impressão térmica e envio digital pelo WhatsApp.'],
 [ScanFace,'Reconhecimento','Identifica colaboradores e personaliza o atendimento.'],
 [Boxes,'Estoque por voz','Consulta e atualização sem navegar por menus complexos.'],
 [Plug,'Integrações flexíveis','Conexão com CRM, PDV, catálogo e APIs da operação.'],
 [RefreshCw,'Sempre atualizado','Atualizações automáticas para evoluir continuamente.'],
];
const flow=['Cliente se aproxima','A câmera detecta a presença','O assistente dá boas-vindas','A pergunta é feita por voz','Preço, estoque ou localização aparecem','Atendimento concluído'];
const demos=[
 ['Apresentação completa','Veja o terminal reconhecendo pessoas e conduzindo o atendimento.','/videos/apresentacao.mp4','/images/poster-apresentacao.webp'],
 ['Consulta de produtos','Uma busca rápida por voz, com dados claros para o cliente.','/videos/produtos.mp4','/images/poster-produtos.webp'],
 ['Recebendo pagamento','Geração do PIX e conclusão segura da jornada.','/videos/pagamento.mp4','/images/poster-pagamento.webp'],
 ['Atualização de estoque','Rotina do colaborador simplificada por comandos de voz.','/videos/estoque.mp4','/images/poster-estoque.webp'],
];
---
<Base>
  <header class="fixed inset-x-0 top-0 z-40 border-b border-white/8 bg-[#070b0ad9] backdrop-blur-xl">
    <nav class="shell flex h-[70px] items-center justify-between" aria-label="Navegação principal">
      <a href="#inicio" class="flex items-center gap-3 font-semibold"><span class="grid size-9 place-items-center rounded-xl bg-[#23d18b] text-[#06120d]"><Store size={19}/></span><span>Assistente <span class="text-[#7e8c86]">da Loja</span></span></a>
      <div class="hidden items-center gap-7 text-sm text-[#aeb8b4] md:flex"><a href="#solucao">Solução</a><a href="#recursos">Recursos</a><a href="#integracoes">Integrações</a><a href="#demonstracao">Demonstração</a></div>
      <a href="/contato" class="btn btn-primary !min-h-10 !px-4 text-sm">Tirar dúvidas <ArrowUpRight size={16}/></a>
    </nav>
  </header>

  <main>
    <section id="inicio" class="relative min-h-[94svh] overflow-hidden pt-[70px]">
      <div class="absolute inset-0"><video autoplay muted loop playsinline poster="/images/poster-produtos.webp" class="h-full w-full object-cover object-center opacity-45"><source src="/videos/produtos.mp4" type="video/mp4"/></video><div class="absolute inset-0 bg-[linear-gradient(90deg,#070b0a_0%,#070b0ae8_38%,#070b0a33_72%),linear-gradient(0deg,#070b0a_0%,transparent_40%)]"></div></div>
      <div class="shell relative flex min-h-[calc(94svh-70px)] items-center py-16">
        <div class="max-w-[760px] reveal visible"><p class="eyebrow">Tecnologia que atende</p><h1 class="my-6 text-[clamp(4.2rem,10vw,8.7rem)] font-medium leading-[.82] tracking-[-.075em]">Assistente<br/><span class="text-[#23d18b]">da Loja.</span></h1><p class="max-w-[640px] text-[clamp(1.05rem,2vw,1.35rem)] leading-relaxed text-[#c4ccc8]">Atendimento inteligente por voz para modernizar a experiência do cliente no varejo — da primeira pergunta ao pagamento.</p><div class="mt-9 flex flex-wrap gap-3"><a class="btn btn-primary" href="/contato">Solicitar demonstração <ArrowUpRight size={18}/></a><a class="btn bg-[#0b100dcf]" href="#demonstracao">Ver como funciona <ArrowDown size={18}/></a></div></div>
      </div>
    </section>

    <section id="solucao" class="py-24 md:py-36"><div class="shell grid gap-16 lg:grid-cols-[.85fr_1.15fr] lg:items-center"><div class="reveal"><p class="eyebrow">Presença que transforma</p><h2 class="section-title">Um novo ponto de contato dentro da loja.</h2><p class="section-copy">O terminal une voz, visão e dados da operação para responder com agilidade, reduzir filas e liberar sua equipe para atendimentos que exigem atenção humana.</p><div class="mt-8 flex gap-8 border-t border-white/10 pt-7"><div><strong class="text-3xl text-[#23d18b]">24/7</strong><p class="mt-1 text-sm text-[#8e9994]">disponível</p></div><div><strong class="text-3xl text-[#23d18b]">1</strong><p class="mt-1 text-sm text-[#8e9994]">ponto inteligente</p></div><div><strong class="text-3xl text-[#23d18b]">Voz</strong><p class="mt-1 text-sm text-[#8e9994]">interface natural</p></div></div></div><div class="relative reveal"><div class="panel overflow-hidden rounded-[30px] p-3"><img src="/images/poster-apresentacao.webp" alt="Terminal Assistente da Loja em funcionamento" class="aspect-[4/5] w-full rounded-[22px] object-cover" loading="lazy"/></div><div class="absolute -bottom-5 -left-5 rounded-2xl border border-[#2c4f40] bg-[#102219] p-4 shadow-2xl"><div class="flex items-center gap-3"><span class="grid size-10 place-items-center rounded-full bg-[#23d18b] text-[#06120d]"><AudioLines size={20}/></span><div><strong class="block text-sm">Estou ouvindo</strong><span class="text-xs text-[#8fa198]">Fale naturalmente</span></div></div></div></div></div></section>

    <section id="demonstracao" class="border-y border-white/8 bg-[#090e0c] py-24 md:py-32"><div class="shell"><div class="reveal"><p class="eyebrow">Em operação</p><h2 class="section-title">Veja a experiência real.</h2><p class="section-copy">Demonstrações gravadas no equipamento, sem encenação. Escolha uma jornada para assistir.</p></div><div class="mt-12 grid gap-5 md:grid-cols-2">{demos.map(([title,copy,video,poster],i)=><button class="demo group relative min-h-[420px] overflow-hidden rounded-[26px] border border-white/10 text-left reveal" data-video={video} aria-label={`Assistir ${title}`}><img src={poster} alt="" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" loading={i?'lazy':'eager'}/><div class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"></div><div class="absolute inset-x-0 bottom-0 p-7"><span class="mb-5 grid size-14 place-items-center rounded-full bg-[#23d18b] text-[#06120d]"><ArrowUpRight size={23}/></span><h3 class="text-2xl font-semibold">{title}</h3><p class="mt-2 max-w-md text-[#bdc6c2]">{copy}</p></div></button>)}</div></div></section>

    <section id="recursos" class="py-24 md:py-36"><div class="shell"><div class="reveal"><p class="eyebrow">Do atendimento à operação</p><h2 class="section-title">Menos etapas.<br/>Mais autonomia.</h2></div><div class="mt-14 grid border-l border-t border-white/10 sm:grid-cols-2 lg:grid-cols-4">{features.map(([Icon,title,copy],i)=><article class="min-h-[260px] border-b border-r border-white/10 p-7 reveal"><span class="mb-12 grid size-11 place-items-center rounded-xl bg-[#10251b] text-[#4ee3a0]"><Icon size={22}/></span><span class="mb-3 block text-xs text-[#53605a]">0{i+1}</span><h3 class="text-lg font-semibold">{title}</h3><p class="mt-3 text-sm leading-relaxed text-[#8f9a95]">{copy}</p></article>)}</div></div></section>

    <section class="bg-[#dbe5df] py-24 text-[#09110d] md:py-36"><div class="shell"><p class="eyebrow !text-[#0b7c52]">Jornada fluida</p><h2 class="section-title">Natural para o cliente.<br/>Poderoso para a loja.</h2><div class="mt-16 grid gap-0 lg:grid-cols-6">{flow.map((step,i)=><div class="group relative border-l border-[#a9b6af] px-5 pb-10 reveal"><span class="mb-7 grid size-10 place-items-center rounded-full border border-[#95a59c] font-mono text-sm group-hover:border-[#0b7c52] group-hover:bg-[#0b7c52] group-hover:text-white">{i+1}</span><h3 class="font-semibold leading-snug">{step}</h3><div class="absolute bottom-0 left-0 h-[2px] w-0 bg-[#0b7c52] transition-all duration-700 group-hover:w-full"></div></div>)}</div></div></section>

    <section class="py-24 md:py-36"><div class="shell grid gap-10 lg:grid-cols-2"><div class="reveal"><p class="eyebrow">Também para sua equipe</p><h2 class="section-title">Operação sem atrito.</h2><p class="section-copy">Colaboradores reconhecidos pelo terminal acessam rotinas internas com comandos protegidos e uma interface direta.</p></div><div class="panel rounded-[26px] p-7 reveal"><ul class="grid gap-0 sm:grid-cols-2">{['Receber pagamentos','Gerar QR Code PIX','Atualizar estoque','Registrar vendas','Consultar produtos','Emitir comprovantes','Controlar por voz','Reiniciar com proteção'].map(item=><li class="flex items-center gap-3 border-b border-white/8 py-4 text-sm"><Check size={17} class="text-[#23d18b]"/>{item}</li>)}</ul></div></div></section>

    <section id="integracoes" class="border-y border-white/8 bg-[#0b100e] py-24 md:py-32"><div class="shell"><div class="grid gap-10 lg:grid-cols-2 lg:items-end"><div class="reveal"><p class="eyebrow">Integrações</p><h2 class="section-title">Conecta com o que sua operação já usa.</h2></div><p class="section-copy reveal">CRM, PDV, estoque, catálogo, WhatsApp, impressora térmica e APIs personalizadas. As integrações são configuráveis para acompanhar cada realidade operacional.</p></div><div class="mt-14 flex flex-wrap gap-3">{['CRM','PDV','Estoque','Catálogo','WhatsApp','Impressora térmica','APIs'].map(x=><span class="rounded-full border border-[#304038] bg-[#111a16] px-5 py-3 text-sm text-[#c8d2cd] reveal">{x}</span>)}</div></div></section>

    <section class="py-24 md:py-40"><div class="shell"><div class="relative overflow-hidden rounded-[34px] border border-[#315947] bg-[#10251b] px-7 py-16 text-center md:px-16 md:py-24 reveal"><Sparkles class="mx-auto mb-6 text-[#59e6a5]" size={34}/><h2 class="mx-auto max-w-4xl text-[clamp(2.5rem,7vw,6rem)] font-medium leading-[.92] tracking-[-.06em]">Transforme o atendimento da sua loja.</h2><p class="mx-auto mt-6 max-w-2xl text-lg text-[#b6c8bf]">Ofereça uma experiência moderna, rápida e inteligente para seus clientes.</p><div class="mt-9 flex flex-wrap justify-center gap-3"><a class="btn btn-primary" href="/contato">Solicitar demonstração <ArrowUpRight size={18}/></a><a class="btn bg-[#0a1711]" href="/contato?canal=whatsapp"><MessageCircle size={18}/> Falar no WhatsApp</a></div></div></div></section>
  </main>
  <footer class="border-t border-white/10 py-10"><div class="shell flex flex-col gap-5 text-sm text-[#7f8c86] md:flex-row md:items-center md:justify-between"><p>© {new Date().getFullYear()} Assistente da Loja · Minas Force</p><div class="flex gap-6"><a href="/privacidade">Privacidade</a><a href="/contato">Contato</a></div></div></footer>

  <dialog id="video-modal"><button class="modal-close" aria-label="Fechar"><X class="mx-auto" size={22}/></button><div class="modal-inner"><video controls playsinline></video></div></dialog>
  <script is:inline>
    const modal=document.querySelector('#video-modal'),player=modal.querySelector('video');
    document.querySelectorAll('.demo').forEach(btn=>btn.addEventListener('click',()=>{player.src=btn.dataset.video;modal.showModal()}));
    const close=()=>{player.pause();player.removeAttribute('src');modal.close()};
    modal.querySelector('.modal-close').addEventListener('click',close);modal.addEventListener('click',e=>{if(e.target===modal||e.target.classList.contains('modal-inner'))close()});
  </script>
</Base>
