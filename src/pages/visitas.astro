---
import Base from '../layouts/Base.astro';
import { dashboardAuth } from '../lib/dashboardAuth';
import { describeDevice, readVisits } from '../lib/visits';
const auth=dashboardAuth(Astro.request);
if(!auth.configured)return new Response('Painel ainda não configurado no servidor.',{status:503});
if(!auth.authorized)return new Response('Autenticação necessária.',{status:401,headers:{'WWW-Authenticate':'Basic realm="Painel de visitas", charset="UTF-8"'}});
const visits=(await readVisits()).sort((a,b)=>b.at.localeCompare(a.at));
const dateKey=(value:string|Date)=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo'}).format(new Date(value));
const today=dateKey(new Date()),todayVisits=visits.filter(v=>dateKey(v.at)===today),firstSeen=new Map<string,string>();
for(const visit of [...visits].reverse())if(!firstSeen.has(visit.visitor))firstSeen.set(visit.visitor,dateKey(visit.at));
const uniqueTotal=new Set(visits.map(v=>v.visitor)).size,newToday=[...firstSeen.values()].filter(day=>day===today).length;
const pageCounts=[...visits.reduce((map,v)=>map.set(v.path,(map.get(v.path)||0)+1),new Map<string,number>())].sort((a,b)=>b[1]-a[1]).slice(0,8);
const days=Array.from({length:7},(_,i)=>{const d=new Date();d.setDate(d.getDate()-(6-i));return dateKey(d)}),daily=days.map(day=>({day,count:visits.filter(v=>dateKey(v.at)===day).length})),maxDaily=Math.max(...daily.map(d=>d.count),1);
const fmt=(date:string)=>new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Sao_Paulo',dateStyle:'short',timeStyle:'short'}).format(new Date(date));
---
<Base title="Painel de visitas | Assistente da Loja" description="Painel privado de métricas." noindex={true} trackVisit={false} structured={false}>
<main class="dashboard-shell">
  <header class="dashboard-header"><div><p class="eyebrow">Métricas privadas</p><h1>Visitas do site</h1><p>Dados atualizados a cada acesso registrado.</p></div><a href="/" class="btn">Voltar ao site</a></header>
  <section class="metric-grid" aria-label="Resumo das visitas">
    <article><span>Visitas gerais</span><strong>{visits.length}</strong><small>visualizações registradas</small></article><article><span>Visitas hoje</span><strong>{todayVisits.length}</strong><small>desde 00:00</small></article><article><span>Visitantes únicos</span><strong>{uniqueTotal}</strong><small>identificadores anônimos</small></article><article><span>Novos hoje</span><strong>{newToday}</strong><small>primeira visita hoje</small></article>
  </section>
  <section class="dashboard-grid">
    <article class="dashboard-card chart"><h2>Últimos 7 dias</h2><div class="bars">{daily.map(item=><div class="bar-column"><span>{item.count}</span><div class="bar-track"><i style={`height:${Math.max(item.count/maxDaily*100,item.count?8:0)}%`}></i></div><small>{item.day.slice(5).split('-').reverse().join('/')}</small></div>)}</div></article>
    <article class="dashboard-card"><h2>Páginas mais visitadas</h2><ol class="ranking">{pageCounts.length?pageCounts.map(([page,count])=><li><span>{page}</span><strong>{count}</strong></li>):<li class="empty">Nenhuma visita registrada.</li>}</ol></article>
  </section>
  <section class="dashboard-card recent"><h2>Visitas recentes</h2><div class="table-wrap"><table><thead><tr><th>Data</th><th>Página</th><th>IP</th><th>Região aproximada</th><th>Operadora</th><th>Visitante</th><th>Dispositivo</th></tr></thead><tbody>{visits.slice(0,100).map(v=><tr><td>{fmt(v.at)}</td><td>{v.path}</td><td class="nowrap">{v.ip||'Não registrado'}</td><td>{v.location}</td><td>{v.operator||'Não registrada'}</td><td title={v.visitor}>{v.visitor.slice(0,10)}…</td><td class="device" title={v.userAgent}>{describeDevice(v.userAgent)}</td></tr>)}</tbody></table>{!visits.length&&<p class="empty">As próximas visitas aparecerão aqui.</p>}</div></section>
</main>
</Base>
<style>
.dashboard-shell{width:min(1400px,calc(100% - 32px));margin:auto;padding:48px 0 70px}.dashboard-header{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:34px}.dashboard-header h1{font-size:clamp(2.5rem,6vw,4.5rem);letter-spacing:-.055em;margin:.45rem 0}.dashboard-header p{color:#93a099}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.metric-grid article,.dashboard-card{border:1px solid #1e3028;background:#0c1310;border-radius:22px;padding:24px}.metric-grid span,.metric-grid small{display:block;color:#8d9b94}.metric-grid strong{display:block;font-size:2.8rem;color:#58e5a4;margin:.5rem 0}.dashboard-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:14px;margin:14px 0}.dashboard-card h2{font-size:1rem;margin:0 0 24px}.bars{height:230px;display:flex;align-items:stretch;gap:12px}.bar-column{flex:1;display:flex;flex-direction:column;text-align:center;color:#8d9b94;font-size:.75rem}.bar-column>span{height:24px}.bar-track{flex:1;display:flex;align-items:end;background:#111c17;border-radius:8px;overflow:hidden;margin:5px 0 9px}.bar-track i{display:block;width:100%;background:linear-gradient(#55e5a3,#16a66b);border-radius:8px}.ranking{list-style:none;padding:0;margin:0}.ranking li{display:flex;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid #1c2923;color:#aab5af}.ranking strong{color:#58e5a4}.recent{padding:0;overflow:hidden}.recent h2{padding:24px 24px 0}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:1250px}th,td{text-align:left;padding:14px 20px;border-top:1px solid #1c2923;font-size:.82rem}th{color:#718078;font-weight:600}td{color:#b5beb9}.nowrap{white-space:nowrap}.device{max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{color:#718078!important;padding:20px!important}.recent>.table-wrap>.empty{margin:0}@media(max-width:850px){.metric-grid{grid-template-columns:repeat(2,1fr)}.dashboard-grid{grid-template-columns:1fr}.dashboard-header{align-items:start;flex-direction:column}}@media(max-width:480px){.metric-grid{grid-template-columns:1fr}.dashboard-shell{padding-top:28px}}
</style>
