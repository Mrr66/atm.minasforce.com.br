---
import Base from '../layouts/Base.astro';
import { ArrowLeft, ArrowUpRight, Mail, MessageCircle, Store } from 'lucide-astro';
---
<Base title="Contato | Assistente da Loja" description="Solicite uma demonstração do Assistente da Loja.">
<header class="shell flex h-20 items-center justify-between"><a href="/" class="flex items-center gap-3 font-semibold"><span class="grid size-9 place-items-center rounded-xl bg-[#23d18b] text-[#06120d]"><Store size={19}/></span>Assistente da Loja</a><a class="btn" href="/"><ArrowLeft size={17}/> Voltar</a></header>
<main class="shell grid min-h-[calc(100svh-160px)] gap-12 py-16 lg:grid-cols-[.8fr_1.2fr] lg:items-start"><section><p class="eyebrow">Vamos conversar</p><h1 class="section-title">Veja o terminal em ação.</h1><p class="section-copy">Conte um pouco sobre sua operação. Nossa equipe entra em contato para entender o cenário e preparar uma demonstração.</p><div class="mt-10 space-y-3 text-sm text-[#aab5af]"><p class="flex items-center gap-3"><MessageCircle size={18} class="text-[#23d18b]"/> WhatsApp comercial</p><p class="flex items-center gap-3"><Mail size={18} class="text-[#23d18b]"/> E-mail comercial</p></div></section><form class="panel rounded-[28px] p-7 md:p-10" action="mailto:comercial@minasforce.com.br" method="post" enctype="text/plain"><div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm">Nome<input required name="nome" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm">Empresa<input required name="empresa" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm">Telefone / WhatsApp<input required name="telefone" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm">E-mail<input required type="email" name="email" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm sm:col-span-2">Como podemos ajudar?<textarea name="mensagem" rows="5" class="resize-none rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"></textarea></label></div><button class="btn btn-primary mt-6 w-full" type="submit">Solicitar demonstração <ArrowUpRight size={18}/></button><p class="mt-4 text-center text-xs text-[#718078]">Ao enviar, você concorda com nossa política de privacidade.</p></form></main>
</Base>
