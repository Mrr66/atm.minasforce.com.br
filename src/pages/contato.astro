---
import Base from '../layouts/Base.astro';
import { ArrowLeft, ArrowUpRight, Mail, MessageCircle, Store } from 'lucide-astro';
---
<Base title="Contato | Assistente da Loja" description="Solicite uma demonstração do Assistente da Loja.">
<header class="shell flex h-20 items-center justify-between"><a href="/" class="flex items-center gap-3 font-semibold"><span class="grid size-9 place-items-center rounded-xl bg-[#23d18b] text-[#06120d]"><Store size={19}/></span>Assistente da Loja</a><a class="btn" href="/"><ArrowLeft size={17}/> Voltar</a></header>
<main class="shell grid min-h-[calc(100svh-160px)] gap-12 py-16 lg:grid-cols-[.8fr_1.2fr] lg:items-start"><section><p class="eyebrow">Vamos conversar</p><h1 class="section-title">Veja o terminal em ação.</h1><p class="section-copy">Conte um pouco sobre sua operação. Nossa equipe entra em contato para entender o cenário e preparar uma demonstração.</p><div class="mt-10 space-y-3 text-sm text-[#aab5af]"><p class="flex items-center gap-3"><MessageCircle size={18} class="text-[#23d18b]"/> WhatsApp comercial</p><p class="flex items-center gap-3"><Mail size={18} class="text-[#23d18b]"/> E-mail comercial</p></div></section>
<form id="lead-form" class="panel rounded-[28px] p-7 md:p-10"><div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm">Nome<input required name="nome" autocomplete="name" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm">Empresa<input required name="empresa" autocomplete="organization" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm">Telefone / WhatsApp<input required name="telefone" autocomplete="tel" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm">E-mail<input required type="email" name="email" autocomplete="email" class="rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"/></label><label class="grid gap-2 text-sm sm:col-span-2">Como podemos ajudar?<textarea name="mensagem" rows="5" class="resize-none rounded-xl border border-white/10 bg-[#080d0b] p-4 outline-none focus:border-[#23d18b]"></textarea></label></div><button class="btn btn-primary mt-6 w-full" type="submit">Solicitar demonstração <ArrowUpRight size={18}/></button><p id="form-status" class="mt-4 min-h-5 text-center text-sm text-[#718078]" aria-live="polite">Ao enviar, você concorda com nossa política de privacidade.</p></form></main>
<script is:inline>
  const form=document.querySelector('#lead-form'),status=document.querySelector('#form-status'),button=form.querySelector('button');
  form.addEventListener('submit',async event=>{event.preventDefault();button.disabled=true;button.textContent='Enviando…';status.textContent='Enviando seus dados com segurança…';
    try{const data=Object.fromEntries(new FormData(form));const response=await fetch('/api/lead',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Erro ao enviar.');form.reset();status.textContent='✓ Solicitação enviada. Entraremos em contato em breve.';status.className='mt-4 min-h-5 text-center text-sm text-[#59e6a5]';}
    catch(error){status.textContent=error.message||'Não foi possível enviar. Tente novamente.';status.className='mt-4 min-h-5 text-center text-sm text-red-300';}
    finally{button.disabled=false;button.textContent='Solicitar demonstração ↗';}
  });
</script>
</Base>
